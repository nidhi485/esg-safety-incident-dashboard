# Copy to .env (git-ignored) for local runs, or set these as Railway "Variables".
# Nothing here is required: without them the app runs fully and explanations use the template.

# Optional GenAI explanation layer (backend/llm_explainer.py)
# Provider: none | anthropic | openai
LLM_PROVIDER=none
# Your provider key - never commit it
LLM_API_KEY=
# Optional model id; defaults: anthropic=claude-haiku-5-5, openai=gpt-4o-mini
LLM_MODEL=
# Optional: any OpenAI-compatible endpoint URL
LLM_BASE_URL=
# Seconds before giving up and falling back to the template
LLM_TIMEOUT=8
